# ═══════════════════════════════════════════════════════════════
# CONFIGURATION ENVIRONNEMENT - PharmaPro
# ═══════════════════════════════════════════════════════════════
# 
# Ce fichier contient TOUTES les variables de configuration.
# Copiez ce fichier en .env.local et modifiez les valeurs selon vos besoins.
#
# IMPORTANT: Ne committez JAMAIS le fichier .env.local dans Git !
# ═══════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────
# ENVIRONNEMENT DE L'APPLICATION
# ───────────────────────────────────────────────────────────────
# Valeurs possibles: dev, prod, test
# dev = Mode développement (avec debug)
# prod = Mode production (optimisé, sans debug)
APP_ENV=dev

# Clé secrète pour sécuriser l'application
# ⚠️ CHANGEZ CETTE VALEUR EN PRODUCTION !
# Générer une nouvelle clé: php bin/console secrets:generate-keys
APP_SECRET=votre_cle_secrete_unique_a_changer_en_production_123456789

# ───────────────────────────────────────────────────────────────
# BASE DE DONNÉES
# ───────────────────────────────────────────────────────────────

# Pour MySQL (RECOMMANDÉ pour ce projet):
# Format: mysql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/NOM_BASE
# Exemple simple (XAMPP/WAMP):
DATABASE_URL="mysql://root:@127.0.0.1:3306/pharma_db?serverVersion=8.0&charset=utf8mb4"

# Si vous avez un mot de passe MySQL:
# DATABASE_URL="mysql://root:votre_mot_de_passe@127.0.0.1:3306/pharma_db?serverVersion=8.0&charset=utf8mb4"

# Pour PostgreSQL (Alternative):
# DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/pharma_db?serverVersion=15&charset=utf8"

# EXPLICATION DES PARAMÈTRES:
# - root = utilisateur MySQL (par défaut)
# - @ = pas de mot de passe (XAMPP par défaut)
# - 127.0.0.1 = localhost (votre ordinateur)
# - 3306 = port MySQL par défaut
# - pharma_db = nom de la base de données (sera créée automatiquement)
# - serverVersion=8.0 = version de MySQL

# ───────────────────────────────────────────────────────────────
# EMAIL / MAILER
# ───────────────────────────────────────────────────────────────

# Pour le développement (MailHog / MailCatcher):
MAILER_DSN=smtp://localhost:1025

# Pour Gmail (Production):
# MAILER_DSN=gmail+smtp://votre-email@gmail.com:votre-app-password@default

# Pour un serveur SMTP personnalisé:
# MAILER_DSN=smtp://utilisateur:password@smtp.example.com:587

# Email administrateur (pour recevoir les alertes):
ADMIN_EMAIL=admin@pharma.local
ALERT_EMAIL=alerts@pharma.local

# ───────────────────────────────────────────────────────────────
# PARAMÈTRES DE L'APPLICATION
# ───────────────────────────────────────────────────────────────

# Timezone
APP_TIMEZONE=Africa/Tunis

# Langue par défaut
APP_LOCALE=fr

# Devise
APP_CURRENCY=TND

# ───────────────────────────────────────────────────────────────
# NOTIFICATIONS
# ───────────────────────────────────────────────────────────────

# Seuil de stock bas (pour alertes)
LOW_STOCK_THRESHOLD=10

# Jours avant expiration pour alertes
EXPIRY_WARNING_DAYS=30
NEAR_EXPIRY_DAYS=90

# ───────────────────────────────────────────────────────────────
# SMS (Optionnel - pour notifications SMS)
# ───────────────────────────────────────────────────────────────
# SMS_API_KEY=votre_cle_api_sms
# SMS_API_URL=https://api.sms-provider.com

# ───────────────────────────────────────────────────────────────
# UPLOADS
# ───────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE=10M
UPLOAD_DIRECTORY=public/uploads

# ───────────────────────────────────────────────────────────────
# CACHE (Optionnel - pour performances)
# ───────────────────────────────────────────────────────────────
# Redis (si installé):
# REDIS_URL=redis://localhost:6379

# Memcached (si installé):
# MEMCACHED_URL=memcached://localhost:11211

# ───────────────────────────────────────────────────────────────
# MESSENGER (Jobs asynchrones - Optionnel)
# ───────────────────────────────────────────────────────────────
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# ───────────────────────────────────────────────────────────────
# PDF GENERATION
# ───────────────────────────────────────────────────────────────
# Chemin vers wkhtmltopdf (si installé):
# WKHTMLTOPDF_PATH=/usr/local/bin/wkhtmltopdf

# ═══════════════════════════════════════════════════════════════
# GUIDE DE CONFIGURATION RAPIDE
# ═══════════════════════════════════════════════════════════════
#
# 1. XAMPP / WAMP (Windows):
#    DATABASE_URL="mysql://root:@127.0.0.1:3306/pharma_db?serverVersion=8.0&charset=utf8mb4"
#
# 2. MAMP (Mac):
#    DATABASE_URL="mysql://root:root@127.0.0.1:8889/pharma_db?serverVersion=8.0&charset=utf8mb4"
#
# 3. Linux (avec mot de passe):
#    DATABASE_URL="mysql://root:votre_mdp@localhost:3306/pharma_db?serverVersion=8.0&charset=utf8mb4"
#
# 4. Docker MySQL:
#    DATABASE_URL="mysql://pharma_user:pharma_pass@mysql:3306/pharma_db?serverVersion=8.0&charset=utf8mb4"
#
# ═══════════════════════════════════════════════════════════════
# APRÈS CONFIGURATION
# ═══════════════════════════════════════════════════════════════
#
# 1. Copier ce fichier: cp .env .env.local
# 2. Modifier .env.local avec vos paramètres
# 3. Créer la base: php bin/console doctrine:database:create
# 4. Lancer les migrations: php bin/console doctrine:migrations:migrate
#
# ═══════════════════════════════════════════════════════════════
