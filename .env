# Environnement de l'application
APP_ENV=dev
APP_SECRET=changez_cette_cle_secrete_en_production

# Database Configuration
DATABASE_URL="mysql://root:password@127.0.0.1:3306/pharma_db?serverVersion=8.0&charset=utf8mb4"
# Alternative PostgreSQL:
# DATABASE_URL="postgresql://user:password@127.0.0.1:5432/pharma_db?serverVersion=15&charset=utf8"

# Mailer Configuration
MAILER_DSN=smtp://localhost:1025
# Production: smtp://user:pass@smtp.example.com:465

# Messenger Configuration (Async jobs)
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# Notification Services
SMS_API_KEY=your_sms_api_key
SMS_API_URL=https://api.sms-provider.com

# App Settings
APP_TIMEZONE=Africa/Tunis
APP_LOCALE=fr
APP_CURRENCY=TND

# Security
LOCK_DSN=flock

# Session
SESSION_LIFETIME=3600

# File Upload Settings
MAX_UPLOAD_SIZE=10M
UPLOAD_DIRECTORY=public/uploads

# Notifications
LOW_STOCK_THRESHOLD=10
EXPIRY_WARNING_DAYS=30
NEAR_EXPIRY_DAYS=90

# Email Recipients
ADMIN_EMAIL=admin@pharmacy.local
ALERT_EMAIL=alerts@pharmacy.local

# Barcode Settings
BARCODE_TYPE=CODE128

# PDF Generation
WKHTMLTOPDF_PATH=/usr/local/bin/wkhtmltopdf

# Cache
REDIS_URL=redis://localhost:6379
# ou
MEMCACHED_URL=memcached://localhost:11211

# Development only
###> symfony/webpack-encore-bundle ###
NODE_ENV=dev
###< symfony/webpack-encore-bundle ###

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=72d3e9926ab7404cd1afef7869bb5404
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###
