{% extends 'base.html.twig' %}

{% block title %}Ventes - PharmaPro{% endblock %}

{% block page_title %}{{ page_title }}{% endblock %}

{% block body %}
<div class="container-fluid">
    {# Barre d'actions et filtres #}
    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Rechercher</label>
                    <input type="text" name="search" class="form-control" 
                           placeholder="N° facture, client..." value="{{ search }}">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Date début</label>
                    <input type="date" name="start_date" class="form-control" value="{{ start_date }}">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Date fin</label>
                    <input type="date" name="end_date" class="form-control" value="{{ end_date }}">
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search"></i> Filtrer
                    </button>
                </div>
            </form>
            <div class="mt-3 text-end">
                <a href="{{ path('app_sale_new') }}" class="btn btn-success">
                    <i class="fas fa-plus-circle me-1"></i> Nouvelle Vente
                </a>
                <button class="btn btn-outline-success">
                    <i class="fas fa-file-excel me-1"></i> Exporter
                </button>
            </div>
        </div>
    </div>

    {# Tableau des ventes #}
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="fas fa-shopping-cart me-2"></i> Liste des ventes
            </h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>N° Facture</th>
                            <th>Date</th>
                            <th>Client</th>
                            <th>Articles</th>
                            <th>Montant Total</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for sale in pagination %}
                        <tr>
                            <td><strong>{{ sale.invoiceNumber }}</strong></td>
                            <td>{{ sale.saleDate|date('d/m/Y H:i') }}</td>
                            <td>
                                {% if sale.customer %}
                                    <i class="fas fa-user me-1"></i>{{ sale.customer.name }}
                                {% else %}
                                    <span class="text-muted">Client anonyme</span>
                                {% endif %}
                            </td>
                            <td>
                                <span class="badge bg-info">
                                    {{ sale.saleItems|length }} article(s)
                                </span>
                            </td>
                            <td>
                                <strong class="text-success">{{ sale.totalAmount|number_format(3, '.', ' ') }} TND</strong>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a href="{{ path('app_sale_show', {id: sale.id}) }}" 
                                       class="btn btn-info" title="Voir">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="{{ path('app_sale_edit', {id: sale.id}) }}" 
                                       class="btn btn-warning" title="Modifier">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form method="post" 
                                          action="{{ path('app_sale_delete', {id: sale.id}) }}" 
                                          style="display: inline;"
                                          onsubmit="return confirm('Supprimer cette vente ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ sale.id) }}">
                                        <button type="submit" class="btn btn-danger btn-sm" title="Supprimer">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="6" class="text-center py-4">
                                <i class="fas fa-shopping-cart fa-3x text-muted mb-3"></i>
                                <p class="text-muted">Aucune vente trouvée.</p>
                                <a href="{{ path('app_sale_new') }}" class="btn btn-primary">
                                    <i class="fas fa-plus-circle me-1"></i> Créer la première vente
                                </a>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {# Pagination #}
            <div class="navigation mt-3">
                {{ knp_pagination_render(pagination) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}