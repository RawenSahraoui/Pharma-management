{% extends 'base.html.twig' %}

{% block title %}Prescriptions - PharmaPro{% endblock %}

{% block page_title %}{{ page_title }}{% endblock %}

{% block body %}
<div class="container-fluid">
    {# Barre d'actions et filtres #}
    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Rechercher</label>
                    <input type="text" name="search" class="form-control" 
                           placeholder="N° prescription, patient, médecin..." value="{{ search }}">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Statut</label>
                    <select name="status" class="form-select">
                        <option value="">Tous les statuts</option>
                        <option value="pending" {% if status == 'pending' %}selected{% endif %}>En attente</option>
                        <option value="prepared" {% if status == 'prepared' %}selected{% endif %}>Préparée</option>
                        <option value="delivered" {% if status == 'delivered' %}selected{% endif %}>Livrée</option>
                        <option value="cancelled" {% if status == 'cancelled' %}selected{% endif %}>Annulée</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search"></i> Filtrer
                    </button>
                </div>
                <div class="col-md-3 text-end">
                    <a href="{{ path('app_prescription_new') }}" class="btn btn-success w-100">
                        <i class="fas fa-plus-circle me-1"></i> Nouvelle Prescription
                    </a>
                </div>
            </form>
        </div>
    </div>

    {# Tableau des prescriptions #}
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="fas fa-prescription me-2"></i> Liste des prescriptions
            </h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>N° Prescription</th>
                            <th>Date</th>
                            <th>Patient</th>
                            <th>Médecin</th>
                            <th>Médicaments</th>
                            <th>Statut</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for prescription in pagination %}
                        <tr>
                            <td><strong>{{ prescription.prescriptionNumber }}</strong></td>
                            <td>{{ prescription.prescriptionDate|date('d/m/Y') }}</td>
                            <td>
                                {% if prescription.customer %}
                                    <i class="fas fa-user me-1"></i>{{ prescription.customer.name }}
                                {% else %}
                                    <span class="text-muted">-</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if prescription.doctor %}
                                    <i class="fas fa-user-md me-1"></i>{{ prescription.doctor.name }}
                                {% else %}
                                    <span class="text-muted">-</span>
                                {% endif %}
                            </td>
                            <td>
                                <span class="badge bg-info">
                                    {{ prescription.prescriptionItems|length }} médicament(s)
                                </span>
                            </td>
                            <td>
                                {% if prescription.status == 'pending' %}
                                    <span class="badge bg-warning text-dark">
                                        <i class="fas fa-clock"></i> En attente
                                    </span>
                                {% elseif prescription.status == 'prepared' %}
                                    <span class="badge bg-info">
                                        <i class="fas fa-check"></i> Préparée
                                    </span>
                                {% elseif prescription.status == 'delivered' %}
                                    <span class="badge bg-success">
                                        <i class="fas fa-check-circle"></i> Livrée
                                    </span>
                                {% elseif prescription.status == 'cancelled' %}
                                    <span class="badge bg-danger">
                                        <i class="fas fa-times-circle"></i> Annulée
                                    </span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a href="{{ path('app_prescription_show', {id: prescription.id}) }}" 
                                       class="btn btn-info" title="Voir">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="{{ path('app_prescription_edit', {id: prescription.id}) }}" 
                                       class="btn btn-warning" title="Modifier">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form method="post" 
                                          action="{{ path('app_prescription_delete', {id: prescription.id}) }}" 
                                          style="display: inline;"
                                          onsubmit="return confirm('Supprimer cette prescription ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ prescription.id) }}">
                                        <button type="submit" class="btn btn-danger btn-sm" title="Supprimer">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="7" class="text-center py-4">
                                <i class="fas fa-prescription fa-3x text-muted mb-3"></i>
                                <p class="text-muted">Aucune prescription trouvée.</p>
                                <a href="{{ path('app_prescription_new') }}" class="btn btn-primary">
                                    <i class="fas fa-plus-circle me-1"></i> Créer la première prescription
                                </a>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {# Pagination #}
            <div class="navigation mt-3">
                {{ knp_pagination_render(pagination) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}