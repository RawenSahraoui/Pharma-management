{% extends 'base.html.twig' %}

{% block title %}Vente {{ sale.invoiceNumber }} - PharmaPro{% endblock %}

{% block page_title %}{{ page_title }}{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="card shadow-sm">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="fas fa-file-invoice me-2"></i> Facture: {{ sale.invoiceNumber }}
            </h5>
            <span class="badge bg-light text-dark">
                {{ sale.saleDate|date('d/m/Y H:i') }}
            </span>
        </div>
        <div class="card-body">
            {# Client Information #}
            <div class="row mb-4">
                <div class="col-md-6">
                    <h6 class="text-muted">
                        <i class="fas fa-user me-2"></i> Informations client
                    </h6>
                    {% if sale.customer %}
                    <table class="table table-sm">
                        <tr>
                            <th width="30%">Nom:</th>
                            <td>{{ sale.customer.name }}</td>
                        </tr>
                        <tr>
                            <th>Email:</th>
                            <td>{{ sale.customer.email ?? '-' }}</td>
                        </tr>
                        <tr>
                            <th>Téléphone:</th>
                            <td>{{ sale.customer.phone ?? '-' }}</td>
                        </tr>
                    </table>
                    {% else %}
                    <p class="text-muted">Client anonyme</p>
                    {% endif %}
                </div>
                
                <div class="col-md-6">
                    <h6 class="text-muted">
                        <i class="fas fa-info-circle me-2"></i> Informations de vente
                    </h6>
                    <table class="table table-sm">
                        <tr>
                            <th width="30%">N° Facture:</th>
                            <td><strong>{{ sale.invoiceNumber }}</strong></td>
                        </tr>
                        <tr>
                            <th>Date:</th>
                            <td>{{ sale.saleDate|date('d/m/Y à H:i') }}</td>
                        </tr>
                        <tr>
                            <th>Articles:</th>
                            <td>{{ sale.saleItems|length }}</td>
                        </tr>
                    </table>
                </div>
            </div>

            <hr>

            {# Sale Items #}
            <h6 class="mb-3">
                <i class="fas fa-list me-2"></i> Détails des articles
            </h6>
            <div class="table-responsive">
                <table class="table table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>Produit</th>
                            <th width="15%">Quantité</th>
                            <th width="15%">Prix unitaire</th>
                            <th width="15%">Sous-total</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in sale.saleItems %}
                        <tr>
                            <td>
                                <strong>{{ item.product.name }}</strong>
                                {% if item.product.reference %}
                                    <br><small class="text-muted">Réf: {{ item.product.reference }}</small>
                                {% endif %}
                            </td>
                            <td class="text-center">{{ item.quantity }}</td>
                            <td class="text-end">{{ item.unitPrice|number_format(3, '.', ' ') }} TND</td>
                            <td class="text-end">
                                <strong>{{ (item.quantity * item.unitPrice)|number_format(3, '.', ' ') }} TND</strong>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <th colspan="3" class="text-end">Total:</th>
                            <th class="text-end text-success fs-5">
                                {{ sale.totalAmount|number_format(3, '.', ' ') }} TND
                            </th>
                        </tr>
                    </tfoot>
                </table>
            </div>

            {# Actions #}
            <div class="d-flex justify-content-between mt-4">
                <a href="{{ path('app_sale_index') }}" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-1"></i> Retour à la liste
                </a>
                <div>
                    <button class="btn btn-outline-primary" onclick="window.print()">
                        <i class="fas fa-print me-1"></i> Imprimer
                    </button>
                    <a href="{{ path('app_sale_edit', {id: sale.id}) }}" class="btn btn-warning">
                        <i class="fas fa-edit me-1"></i> Modifier
                    </a>
                    <form method="post" 
                          action="{{ path('app_sale_delete', {id: sale.id}) }}" 
                          style="display: inline;"
                          onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette vente ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ sale.id) }}">
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash me-1"></i> Supprimer
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
@media print {
    .btn, .card-header, nav { display: none !important; }
    .card { border: none; box-shadow: none !important; }
}
</style>
{% endblock %}