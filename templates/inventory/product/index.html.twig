{% extends 'base.html.twig' %}

{% block title %}Produits - PharmaPro{% endblock %}

{% block page_title %}Gestion des Produits{% endblock %}

{% block body %}
<div class="container-fluid">
    {# Barre d'actions #}
    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <form method="get" class="d-flex gap-2">
                        <input type="text" name="search" class="form-control" 
                               placeholder="Rechercher un produit..." value="{{ search }}">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-search"></i> Rechercher
                        </button>
                    </form>
                </div>
                <div class="col-md-6 text-end">
                    <a href="{{ path('app_product_new') }}" class="btn btn-success">
                        <i class="fas fa-plus-circle me-1"></i> Nouveau Produit
                    </a>
                    <button class="btn btn-outline-secondary" onclick="window.print()">
                        <i class="fas fa-print me-1"></i> Imprimer
                    </button>
                    <a href="{{ path('app_product_export_excel') }}" class="btn btn-outline-success">
                        <i class="fas fa-file-excel me-1"></i> Exporter
                    </a>
                </div>
            </div>

            {# Filtres #}
            <div class="row mt-3">
                <div class="col-md-3">
                    <select class="form-select" name="category" onchange="this.form.submit()">
                        <option value="">Toutes les catégories</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select" name="stock_status" onchange="this.form.submit()">
                        <option value="">Tous les statuts</option>
                        <option value="ok" {{ stock_status == 'ok' ? 'selected' : '' }}>En stock</option>
                        <option value="low" {{ stock_status == 'low' ? 'selected' : '' }}>Stock bas</option>
                        <option value="out" {{ stock_status == 'out' ? 'selected' : '' }}>Rupture de stock</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    {# Tableau des produits #}
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th><input type="checkbox" id="selectAll"></th>
                            <th>Image</th>
                            <th>Code-barres</th>
                            <th>Nom du produit</th>
                            <th>Catégorie</th>
                            <th>Prix d'achat</th>
                            <th>Prix de vente</th>
                            <th>Stock</th>
                            <th>Statut</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for product in pagination %}
                        <tr>
                            <td>
                                <input type="checkbox" class="product-checkbox" value="{{ product.id }}">
                            </td>
                            <td>
                                {% if product.imagePath %}
                                    <img src="{{ asset('uploads/products/' ~ product.imagePath) }}" 
                                         alt="{{ product.name }}" class="rounded" 
                                         style="width: 40px; height: 40px; object-fit: cover;">
                                {% else %}
                                    <img src="https://via.placeholder.com/40?text=No+Img" 
                                         alt="Produit" class="rounded" 
                                         style="width: 40px; height: 40px; object-fit: cover;">
                                {% endif %}
                            </td>
                            <td><code>{{ product.barcode }}</code></td>
                            <td>
                                <strong>{{ product.name }}</strong>
                                {% if product.description %}
                                    <br><small class="text-muted">{{ product.description|slice(0, 50) }}...</small>
                                {% endif %}
                            </td>
                            <td>
                                <span class="badge bg-info">{{ product.category.name }}</span>
                            </td>
                            <td>{{ product.purchasePrice|number_format(2) }} TND</td>
                            <td>
                                <strong class="text-success">{{ product.sellingPrice|number_format(2) }} TND</strong>
                            </td>
                            <td>
                                {% if product.stockQuantity == 0 %}
                                    <span class="badge bg-danger">{{ product.stockQuantity }}</span>
                                {% elseif product.isLowStock %}
                                    <span class="badge bg-warning">{{ product.stockQuantity }}</span>
                                {% else %}
                                    <span class="badge bg-success">{{ product.stockQuantity }}</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if product.stockQuantity == 0 %}
                                    <span class="badge bg-danger">
                                        <i class="fas fa-times-circle"></i> Rupture
                                    </span>
                                {% elseif product.isLowStock %}
                                    <span class="badge bg-warning">
                                        <i class="fas fa-exclamation-triangle"></i> Stock bas
                                    </span>
                                {% else %}
                                    <span class="badge bg-success">
                                        <i class="fas fa-check-circle"></i> En stock
                                    </span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a href="{{ path('app_product_show', {id: product.id}) }}" 
                                       class="btn btn-info" title="Voir">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="{{ path('app_product_edit', {id: product.id}) }}" 
                                       class="btn btn-warning" title="Modifier">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <button class="btn btn-danger btn-delete" 
                                            data-id="{{ product.id }}" 
                                            data-name="{{ product.name }}"
                                            title="Supprimer">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="10" class="text-center py-4">
                                <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
                                <p class="text-muted">Aucun produit trouvé.</p>
                                <a href="{{ path('app_product_new') }}" class="btn btn-primary">
                                    <i class="fas fa-plus-circle me-1"></i> Créer le premier produit
                                </a>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {# Pagination #}
            <div class="navigation mt-3">
                {{ knp_pagination_render(pagination) }}
            </div>
        </div>
    </div>
</div>

{# Modal de suppression #}
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Confirmer la suppression</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Êtes-vous sûr de vouloir supprimer le produit <strong id="productName"></strong> ?</p>
                <p class="text-danger">
                    <i class="fas fa-exclamation-triangle me-2"></i>Cette action est irréversible.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <form method="post" id="deleteForm" style="display: inline;">
                    <input type="hidden" name="_token" id="deleteToken">
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash me-2"></i>Supprimer
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
$(document).ready(function() {
    // Sélectionner tous les produits
    $('#selectAll').on('click', function() {
        $('.product-checkbox').prop('checked', this.checked);
    });

    // Gérer la suppression
    $('.btn-delete').on('click', function(e) {
        e.preventDefault();
        
        const productId = $(this).data('id');
        const productName = $(this).data('name');
        
        // Demander confirmation
        if (confirm('Êtes-vous sûr de vouloir supprimer "' + productName + '" ?\n\nCette action est irréversible.')) {
            // Créer un formulaire et le soumettre
            const form = $('<form>', {
                'method': 'POST',
                'action': '/inventory/product/' + productId
            });
            
            // Ajouter le token CSRF
            const csrfToken = 'delete' + productId;
            form.append($('<input>', {
                'type': 'hidden',
                'name': '_token',
                'value': '{{ csrf_token("delete") }}' + productId
            }));
            
            // Ajouter au DOM et soumettre
            $('body').append(form);
            form.submit();
        }
    });
});
</script>
{% endblock %}
