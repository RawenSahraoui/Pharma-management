{% extends 'base.html.twig' %}

{% block title %}{{ page_title }}{% endblock %}
{% block page_title %}{{ page_title }}{% endblock %}

{% block body %}
<div class="container-fluid">
    {# Statistiques #}
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-warning shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Stock bas</h6>
                            <h2 class="mb-0 text-warning">{{ stats.low_stock_count }}</h2>
                        </div>
                        <div class="text-warning">
                            <i class="fas fa-exclamation-triangle fa-3x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-danger shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Rupture</h6>
                            <h2 class="mb-0 text-danger">{{ stats.out_of_stock_count }}</h2>
                        </div>
                        <div class="text-danger">
                            <i class="fas fa-times-circle fa-3x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-warning shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Expire bientôt</h6>
                            <h2 class="mb-0 text-warning">{{ stats.expiring_count }}</h2>
                        </div>
                        <div class="text-warning">
                            <i class="fas fa-calendar-times fa-3x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-danger shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Périmés</h6>
                            <h2 class="mb-0 text-danger">{{ stats.expired_count }}</h2>
                        </div>
                        <div class="text-danger">
                            <i class="fas fa-ban fa-3x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Onglets #}
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <a class="nav-link {{ active_tab == 'stock-bas' ? 'active' : '' }}" 
               href="{{ path('app_alert_index', {tab: 'stock-bas'}) }}">
                <i class="fas fa-exclamation-triangle text-warning me-2"></i>
                Stock bas ({{ stats.low_stock_count }})
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{ active_tab == 'rupture' ? 'active' : '' }}" 
               href="{{ path('app_alert_index', {tab: 'rupture'}) }}">
                <i class="fas fa-times-circle text-danger me-2"></i>
                Rupture ({{ stats.out_of_stock_count }})
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{ active_tab == 'peremption' ? 'active' : '' }}" 
               href="{{ path('app_alert_index', {tab: 'peremption'}) }}">
                <i class="fas fa-calendar-times text-warning me-2"></i>
                Expire bientôt ({{ stats.expiring_count }})
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{ active_tab == 'expired' ? 'active' : '' }}" 
               href="{{ path('app_alert_index', {tab: 'expired'}) }}">
                <i class="fas fa-ban text-danger me-2"></i>
                Périmés ({{ stats.expired_count }})
            </a>
        </li>
    </ul>

    {# Contenu des onglets #}
    {% if active_tab == 'stock-bas' %}
        <div class="card shadow">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    Produits avec stock bas
                </h5>
            </div>
            <div class="card-body">
                {% if low_stock_products|length > 0 %}
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Produit</th>
                                    <th>Catégorie</th>
                                    <th>Stock actuel</th>
                                    <th>Seuil minimum</th>
                                    <th>Manquant</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for product in low_stock_products %}
                                <tr class="table-warning">
                                    <td><strong>{{ product.name }}</strong></td>
                                    <td>{{ product.category.name }}</td>
                                    <td>
                                        <span class="badge bg-warning">{{ product.stockQuantity }}</span>
                                    </td>
                                    <td>{{ product.minStockLevel }}</td>
                                    <td>
                                        <span class="badge bg-danger">
                                            {{ product.minStockLevel - product.stockQuantity }}
                                        </span>
                                    </td>
                                    <td>
                                        <a href="{{ path('app_product_edit', {id: product.id}) }}" 
                                           class="btn btn-sm btn-primary">
                                            <i class="fas fa-edit"></i> Réapprovisionner
                                        </a>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <div class="text-center py-4">
                        <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                        <p class="text-success">Aucun produit avec stock bas !</p>
                    </div>
                {% endif %}
            </div>
        </div>

    {% elseif active_tab == 'rupture' %}
        <div class="card shadow">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0">
                    <i class="fas fa-times-circle me-2"></i>
                    Produits en rupture de stock
                </h5>
            </div>
            <div class="card-body">
                {% if out_of_stock_products|length > 0 %}
                    <div class="alert alert-danger">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>{{ stats.out_of_stock_count }}</strong> produit(s) en rupture de stock !
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Produit</th>
                                    <th>Catégorie</th>
                                    <th>Code-barres</th>
                                    <th>Seuil minimum</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for product in out_of_stock_products %}
                                <tr class="table-danger">
                                    <td><strong>{{ product.name }}</strong></td>
                                    <td>{{ product.category.name }}</td>
                                    <td><code>{{ product.barcode }}</code></td>
                                    <td>{{ product.minStockLevel }}</td>
                                    <td>
                                        <a href="{{ path('app_product_edit', {id: product.id}) }}" 
                                           class="btn btn-sm btn-danger">
                                            <i class="fas fa-exclamation-circle"></i> Commander
                                        </a>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <div class="text-center py-4">
                        <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                        <p class="text-success">Aucun produit en rupture !</p>
                    </div>
                {% endif %}
            </div>
        </div>

    {% elseif active_tab == 'peremption' %}
        <div class="card shadow">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0">
                    <i class="fas fa-calendar-times me-2"></i>
                    Produits expirant dans les 30 jours
                </h5>
            </div>
            <div class="card-body">
                {% if expiring_products|length > 0 %}
                    <div class="alert alert-warning">
                        <i class="fas fa-info-circle me-2"></i>
                        {{ stats.expiring_count }} produit(s) expirent dans les 30 prochains jours.
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Produit</th>
                                    <th>Lot</th>
                                    <th>Date d'expiration</th>
                                    <th>Jours restants</th>
                                    <th>Stock</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for product in expiring_products %}
                                {% set daysLeft = date(product.expiryDate).diff(date()).days %}
                                <tr class="{{ daysLeft <= 7 ? 'table-danger' : 'table-warning' }}">
                                    <td><strong>{{ product.name }}</strong></td>
                                    <td>{{ product.batchNumber ?? '-' }}</td>
                                    <td>{{ product.expiryDate|date('d/m/Y') }}</td>
                                    <td>
                                        <span class="badge bg-{{ daysLeft <= 7 ? 'danger' : 'warning' }}">
                                            {{ daysLeft }} jour(s)
                                        </span>
                                    </td>
                                    <td>{{ product.stockQuantity }}</td>
                                    <td>
                                        <a href="{{ path('app_product_show', {id: product.id}) }}" 
                                           class="btn btn-sm btn-info">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <div class="text-center py-4">
                        <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                        <p class="text-success">Aucun produit proche de la péremption !</p>
                    </div>
                {% endif %}
            </div>
        </div>

    {% elseif active_tab == 'expired' %}
        <div class="card shadow">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0">
                    <i class="fas fa-ban me-2"></i>
                    Produits périmés
                </h5>
            </div>
            <div class="card-body">
                {% if expired_products|length > 0 %}
                    <div class="alert alert-danger">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>ATTENTION !</strong> {{ stats.expired_count }} produit(s) périmé(s) encore en stock !
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Produit</th>
                                    <th>Lot</th>
                                    <th>Date d'expiration</th>
                                    <th>Périmé depuis</th>
                                    <th>Stock</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for product in expired_products %}
                                {% set daysExpired = date().diff(date(product.expiryDate)).days %}
                                <tr class="table-danger">
                                    <td><strong>{{ product.name }}</strong></td>
                                    <td>{{ product.batchNumber ?? '-' }}</td>
                                    <td>{{ product.expiryDate|date('d/m/Y') }}</td>
                                    <td>
                                        <span class="badge bg-danger">
                                            {{ daysExpired }} jour(s)
                                        </span>
                                    </td>
                                    <td>{{ product.stockQuantity }}</td>
                                    <td>
                                        <a href="{{ path('app_product_edit', {id: product.id}) }}" 
                                           class="btn btn-sm btn-danger">
                                            <i class="fas fa-trash"></i> Retirer
                                        </a>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <div class="text-center py-4">
                        <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                        <p class="text-success">Aucun produit périmé en stock !</p>
                    </div>
                {% endif %}
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}