{% extends 'base.html.twig' %}

{% block title %}{{ page_title }}{% endblock %}
{% block page_title %}{{ page_title }}{% endblock %}

{% block body %}
<div class="container-fluid">
    {# Filtres de période #}
    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="btn-group" role="group">
                <a href="{{ path('app_report_index', {period: '7days'}) }}" 
                   class="btn btn-outline-primary {{ period == '7days' ? 'active' : '' }}">
                    7 jours
                </a>
                <a href="{{ path('app_report_index', {period: '30days'}) }}" 
                   class="btn btn-outline-primary {{ period == '30days' ? 'active' : '' }}">
                    30 jours
                </a>
                <a href="{{ path('app_report_index', {period: '90days'}) }}" 
                   class="btn btn-outline-primary {{ period == '90days' ? 'active' : '' }}">
                    90 jours
                </a>
                <a href="{{ path('app_report_index', {period: '1year'}) }}" 
                   class="btn btn-outline-primary {{ period == '1year' ? 'active' : '' }}">
                    1 an
                </a>
            </div>
            <span class="ms-3 text-muted">
                Du {{ start_date|date('d/m/Y') }} au {{ end_date|date('d/m/Y') }}
            </span>
        </div>
    </div>

    {# Statistiques générales #}
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-primary shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Produits</h6>
                            <h2 class="mb-0">{{ stats.total_products }}</h2>
                            <small class="text-success">{{ stats.active_products }} actifs</small>
                        </div>
                        <div class="text-primary">
                            <i class="fas fa-boxes fa-3x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-warning shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Stock bas</h6>
                            <h2 class="mb-0 text-warning">{{ stats.low_stock_products }}</h2>
                            <small class="text-muted">produits</small>
                        </div>
                        <div class="text-warning">
                            <i class="fas fa-exclamation-triangle fa-3x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-success shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Valeur Stock</h6>
                            <h2 class="mb-0 text-success">{{ stock_value|number_format(0) }}</h2>
                            <small class="text-muted">TND</small>
                        </div>
                        <div class="text-success">
                            <i class="fas fa-dollar-sign fa-3x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-info shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Fournisseurs</h6>
                            <h2 class="mb-0 text-info">{{ stats.total_suppliers }}</h2>
                            <small class="text-success">{{ stats.active_suppliers }} actifs</small>
                        </div>
                        <div class="text-info">
                            <i class="fas fa-truck fa-3x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        {# Top produits #}
        <div class="col-md-6 mb-4">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-chart-bar me-2"></i>
                        Top 10 - Stock le plus élevé
                    </h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Produit</th>
                                    <th class="text-end">Stock</th>
                                    <th class="text-end">Valeur</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for product in top_products %}
                                <tr>
                                    <td>
                                        <strong>{{ product.name }}</strong><br>
                                        <small class="text-muted">{{ product.category.name }}</small>
                                    </td>
                                    <td class="text-end">
                                        <span class="badge bg-success">{{ product.stockQuantity }}</span>
                                    </td>
                                    <td class="text-end">
                                        {{ (product.stockQuantity * product.purchasePrice)|number_format(2) }} TND
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        {# Produits en rupture #}
        <div class="col-md-6 mb-4">
            <div class="card shadow">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        Produits en rupture
                    </h5>
                </div>
                <div class="card-body">
                    {% if out_of_stock|length > 0 %}
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Produit</th>
                                    <th>Catégorie</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for product in out_of_stock %}
                                <tr>
                                    <td><strong>{{ product.name }}</strong></td>
                                    <td>{{ product.category.name }}</td>
                                    <td>
                                        <a href="{{ path('app_product_edit', {id: product.id}) }}" class="btn btn-sm btn-primary">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% else %}
                    <p class="text-center text-success">
                        <i class="fas fa-check-circle fa-3x mb-3"></i><br>
                        Aucun produit en rupture de stock
                    </p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {# Répartition par catégorie #}
    <div class="row">
        <div class="col-md-12">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-pie-chart me-2"></i>
                        Répartition par catégorie
                    </h5>
                </div>
                <div class="card-body">
                    <canvas id="categoryChart" height="80"></canvas>
                </div>
            </div>
        </div>
    </div>

    {# Liens rapides #}
    <div class="row mt-4">
        <div class="col-md-3">
            <a href="{{ path('app_report_inventory') }}" class="btn btn-outline-primary btn-lg w-100">
                <i class="fas fa-clipboard-list d-block fa-2x mb-2"></i>
                Rapport Inventaire
            </a>
        </div>
        <div class="col-md-3">
            <a href="{{ path('app_report_stock_movement') }}" class="btn btn-outline-success btn-lg w-100">
                <i class="fas fa-exchange-alt d-block fa-2x mb-2"></i>
                Mouvements Stock
            </a>
        </div>
        <div class="col-md-3">
            <a href="{{ path('app_report_suppliers') }}" class="btn btn-outline-info btn-lg w-100">
                <i class="fas fa-truck d-block fa-2x mb-2"></i>
                Rapport Fournisseurs
            </a>
        </div>
        <div class="col-md-3">
            <a href="{{ path('app_product_index') }}" class="btn btn-outline-secondary btn-lg w-100">
                <i class="fas fa-boxes d-block fa-2x mb-2"></i>
                Tous les produits
            </a>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
const ctx = document.getElementById('categoryChart');
new Chart(ctx, {
    type: 'doughnut',
    data: {
        labels: [{% for stat in category_stats %}'{{ stat.name }}'{% if not loop.last %},{% endif %}{% endfor %}],
        datasets: [{
            data: [{% for stat in category_stats %}{{ stat.count }}{% if not loop.last %},{% endif %}{% endfor %}],
            backgroundColor: [
                '#007bff', '#28a745', '#ffc107', '#dc3545', '#17a2b8', 
                '#6f42c1', '#fd7e14', '#20c997', '#e83e8c', '#6c757d'
            ]
        }]
    },
    options: {
        responsive: true,
        plugins: {
            legend: {
                position: 'right',
            }
        }
    }
});
</script>
{% endblock %}