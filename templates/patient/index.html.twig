{% extends 'base.html.twig' %}

{% block title %}Patients - PharmaPro{% endblock %}

{% block page_title %}{{ page_title }}{% endblock %}

{% block body %}
<div class="container-fluid">
    {# Barre d'actions #}
    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <form method="get" class="d-flex gap-2">
                        <input type="text" name="search" class="form-control" 
                               placeholder="Rechercher un patient..." value="{{ search }}">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-search"></i> Rechercher
                        </button>
                    </form>
                </div>
                <div class="col-md-6 text-end">
                    <a href="{{ path('app_patient_new') }}" class="btn btn-success">
                        <i class="fas fa-plus-circle me-1"></i> Nouveau Patient
                    </a>
                    <button class="btn btn-outline-success">
                        <i class="fas fa-file-excel me-1"></i> Exporter
                    </button>
                </div>
            </div>
        </div>
    </div>

    {# Tableau des patients #}
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="fas fa-users me-2"></i> Liste des patients
            </h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nom</th>
                            <th>Email</th>
                            <th>Téléphone</th>
                            <th>Ville</th>
                            <th>Statut</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for patient in pagination %}
                        <tr>
                            <td>{{ patient.id }}</td>
                            <td><strong>{{ patient.name }}</strong></td>
                            <td>{{ patient.email ?? '-' }}</td>
                            <td>{{ patient.phone ?? '-' }}</td>
                            <td>{{ patient.city ?? '-' }}</td>
                            <td>
                                {% if patient.isActive %}
                                    <span class="badge bg-success">
                                        <i class="fas fa-check-circle"></i> Actif
                                    </span>
                                {% else %}
                                    <span class="badge bg-secondary">
                                        <i class="fas fa-times-circle"></i> Inactif
                                    </span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a href="{{ path('app_patient_show', {id: patient.id}) }}" 
                                       class="btn btn-info" title="Voir">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="{{ path('app_patient_edit', {id: patient.id}) }}" 
                                       class="btn btn-warning" title="Modifier">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form method="post" 
                                          action="{{ path('app_patient_delete', {id: patient.id}) }}" 
                                          style="display: inline;"
                                          onsubmit="return confirm('Supprimer {{ patient.name|escape('js') }} ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ patient.id) }}">
                                        <button type="submit" class="btn btn-danger btn-sm" title="Supprimer">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="7" class="text-center py-4">
                                <i class="fas fa-users fa-3x text-muted mb-3"></i>
                                <p class="text-muted">Aucun patient trouvé.</p>
                                <a href="{{ path('app_patient_new') }}" class="btn btn-primary">
                                    <i class="fas fa-plus-circle me-1"></i> Créer le premier patient
                                </a>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {# Pagination #}
            <div class="navigation mt-3">
                {{ knp_pagination_render(pagination) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}