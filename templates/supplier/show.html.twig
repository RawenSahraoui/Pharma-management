{% extends 'base.html.twig' %}

{% block title %}{{ supplier.name }} - PharmaPro{% endblock %}

{% block page_title %}{{ page_title }}{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fas fa-truck me-2"></i> {{ supplier.name }}
                    </h5>
                    {% if supplier.isActive %}
                        <span class="badge bg-success">
                            <i class="fas fa-check-circle"></i> Actif
                        </span>
                    {% else %}
                        <span class="badge bg-secondary">
                            <i class="fas fa-times-circle"></i> Inactif
                        </span>
                    {% endif %}
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6 class="text-muted mb-3">
                                <i class="fas fa-info-circle"></i> Informations générales
                            </h6>
                            <table class="table table-sm">
                                <tr>
                                    <th width="40%">ID:</th>
                                    <td>{{ supplier.id }}</td>
                                </tr>
                                <tr>
                                    <th>Nom:</th>
                                    <td><strong>{{ supplier.name }}</strong></td>
                                </tr>
                                <tr>
                                    <th>Personne de contact:</th>
                                    <td>{{ supplier.contactPerson ?? '-' }}</td>
                                </tr>
                            </table>
                        </div>

                        <div class="col-md-6">
                            <h6 class="text-muted mb-3">
                                <i class="fas fa-address-book"></i> Contact
                            </h6>
                            <table class="table table-sm">
                                <tr>
                                    <th width="40%">Email:</th>
                                    <td>
                                        {% if supplier.email %}
                                            <a href="mailto:{{ supplier.email }}">{{ supplier.email }}</a>
                                        {% else %}
                                            -
                                        {% endif %}
                                    </td>
                                </tr>
                                <tr>
                                    <th>Téléphone:</th>
                                    <td>
                                        {% if supplier.phone %}
                                            <a href="tel:{{ supplier.phone }}">{{ supplier.phone }}</a>
                                        {% else %}
                                            -
                                        {% endif %}
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <hr>

                    <div class="row">
                        <div class="col-12">
                            <h6 class="text-muted mb-3">
                                <i class="fas fa-map-marker-alt"></i> Adresse
                            </h6>
                            <table class="table table-sm">
                                <tr>
                                    <th width="20%">Adresse:</th>
                                    <td>{{ supplier.address ?? '-' }}</td>
                                </tr>
                                <tr>
                                    <th>Ville:</th>
                                    <td>{{ supplier.city ?? '-' }}</td>
                                </tr>
                                <tr>
                                    <th>Code postal:</th>
                                    <td>{{ supplier.postalCode ?? '-' }}</td>
                                </tr>
                                <tr>
                                    <th>Pays:</th>
                                    <td>{{ supplier.country ?? '-' }}</td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a href="{{ path('app_supplier_index') }}" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i> Retour à la liste
                        </a>
                        <div>
                            <a href="{{ path('app_supplier_edit', {id: supplier.id}) }}" class="btn btn-warning">
                                <i class="fas fa-edit me-1"></i> Modifier
                            </a>
                            <form method="post" 
                                  action="{{ path('app_supplier_delete', {id: supplier.id}) }}" 
                                  style="display: inline;"
                                  onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce fournisseur ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ supplier.id) }}">
                                <button type="submit" class="btn btn-danger">
                                    <i class="fas fa-trash me-1"></i> Supprimer
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}