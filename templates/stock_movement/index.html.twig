{% extends 'base.html.twig' %}

{% block title %}{{ page_title }}{% endblock %}
{% block page_title %}{{ page_title }}{% endblock %}

{% block body %}
<div class="container-fluid">
    {# Statistiques #}
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-primary shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Total mouvements</h6>
                            <h2 class="mb-0">{{ stats.total_movements }}</h2>
                        </div>
                        <div class="text-primary">
                            <i class="fas fa-exchange-alt fa-3x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-success shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Entrées</h6>
                            <h2 class="mb-0 text-success">{{ stats.total_in }}</h2>
                        </div>
                        <div class="text-success">
                            <i class="fas fa-arrow-down fa-3x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-danger shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Sorties</h6>
                            <h2 class="mb-0 text-danger">{{ stats.total_out }}</h2>
                        </div>
                        <div class="text-danger">
                            <i class="fas fa-arrow-up fa-3x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-warning shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Ajustements</h6>
                            <h2 class="mb-0 text-warning">{{ stats.total_adjustment }}</h2>
                        </div>
                        <div class="text-warning">
                            <i class="fas fa-sliders-h fa-3x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Filtres et actions #}
    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <form method="get" class="row g-2">
                        <div class="col-md-4">
                            <select name="type" class="form-select" onchange="this.form.submit()">
                                <option value="all" {{ filter_type == 'all' ? 'selected' : '' }}>Tous les types</option>
                                <option value="in" {{ filter_type == 'in' ? 'selected' : '' }}>Entrées</option>
                                <option value="out" {{ filter_type == 'out' ? 'selected' : '' }}>Sorties</option>
                                <option value="adjustment" {{ filter_type == 'adjustment' ? 'selected' : '' }}>Ajustements</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <select name="product" class="form-select" onchange="this.form.submit()">
                                <option value="">Tous les produits</option>
                                {% for product in products %}
                                    <option value="{{ product.id }}" {{ filter_product == product.id ? 'selected' : '' }}>
                                        {{ product.name }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-2">
                            <a href="{{ path('app_stock_index') }}" class="btn btn-secondary w-100">
                                <i class="fas fa-redo"></i> Réinitialiser
                            </a>
                        </div>
                    </form>
                </div>
                <div class="col-md-4 text-end">
                    <a href="{{ path('app_stock_new') }}" class="btn btn-success">
                        <i class="fas fa-plus-circle me-1"></i> Nouveau Mouvement
                    </a>
                </div>
            </div>
        </div>
    </div>

    {# Liste des mouvements #}
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="fas fa-list me-2"></i> Liste des Mouvements
            </h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Produit</th>
                            <th>Type</th>
                            <th>Quantité</th>
                            <th>Stock après</th>
                            <th>Motif</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for movement in pagination %}
                        <tr>
                            <td>{{ movement.createdAt|date('d/m/Y H:i') }}</td>
                            <td>
                                <strong>{{ movement.product.name }}</strong><br>
                                <small class="text-muted">{{ movement.product.barcode }}</small>
                            </td>
                            <td>
                                {% if movement.type == 'in' %}
                                    <span class="badge bg-success">
                                        <i class="fas fa-arrow-down"></i> Entrée
                                    </span>
                                {% elseif movement.type == 'out' %}
                                    <span class="badge bg-danger">
                                        <i class="fas fa-arrow-up"></i> Sortie
                                    </span>
                                {% else %}
                                    <span class="badge bg-warning">
                                        <i class="fas fa-sliders-h"></i> Ajustement
                                    </span>
                                {% endif %}
                            </td>
                            <td>
                                <strong class="text-{{ movement.type == 'in' ? 'success' : 'danger' }}">
                                    {{ movement.type == 'in' ? '+' : '-' }}{{ movement.quantity }}
                                </strong>
                            </td>
                            <td>
                                <span class="badge bg-info">{{ movement.product.stockQuantity }}</span>
                            </td>
                            <td>
                                <small class="text-muted">{{ movement.reason|slice(0, 50)|default('-') }}</small>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a href="{{ path('app_stock_show', {id: movement.id}) }}" 
                                       class="btn btn-info" title="Voir">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <form method="post" 
                                          action="{{ path('app_stock_delete', {id: movement.id}) }}" 
                                          style="display: inline;"
                                          onsubmit="return confirm('Supprimer ce mouvement ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ movement.id) }}">
                                        <button type="submit" class="btn btn-danger btn-sm" title="Supprimer">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="7" class="text-center py-4">
                                <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                                <p class="text-muted">Aucun mouvement de stock trouvé.</p>
                                <a href="{{ path('app_stock_new') }}" class="btn btn-primary">
                                    <i class="fas fa-plus-circle me-1"></i> Créer le premier mouvement
                                </a>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {# Pagination #}
            <div class="navigation mt-3">
                {{ knp_pagination_render(pagination) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}